# Release allowlist. Everything else stays local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/production/
/production/*
!/production/pyproject.toml
!/production/MANIFEST.in
!/production/README.md
!/production/PERFORMANCE.md
!/production/rwkv_native/
!/production/tests/
!/production/tools/
/production/rwkv_native/**
!/production/rwkv_native/**/
!/production/rwkv_native/**/*.py
!/production/rwkv_native/csrc/*.cpp
!/production/rwkv_native/csrc/*.cu
!/production/rwkv_native/csrc/*.cuh
!/production/rwkv_native/third_party/**
/production/tests/*
!/production/tests/conftest.py
!/production/tests/wkv_reference.py
!/production/tests/test_runtime_config.py
!/production/tests/test_strict_forward_contract.py
!/production/tests/test_masked_backward.py
!/production/tests/test_checkpoint.py
!/production/tests/test_large_checkpoint.py
!/production/tests/test_wkv.py
!/production/tests/test_head_loss.py
!/production/tests/test_inference_fp64_reference.py
!/production/tests/test_training_fp64_reference.py
!/production/tests/test_training_benchmark_loss.py
/production/tools/*
!/production/tools/benchmark_common.py
!/production/tools/benchmark_model.py
!/production/tools/inference_fp64_check.py
!/production/tools/training_fp64_check.py
!/production/tools/inference_forward_invariance.py
!/production/tools/training_forward_invariance.py
!/production/tools/staged_inference_model.py
!/production/tools/flash_model.py
!/production/tools/FlashRWKV2.LICENSE

# Local outputs, credentials, weights, caches and binaries are never published.
/artifacts/
**/__pycache__/
**/.pytest_cache/
**/*.egg-info/
**/build/
**/dist/
**/.env
**/.env.*
**/*.py[cod]
**/*.so
**/*.o
**/*.whl
**/*.pt
**/*.pth
**/*.ckpt
**/*.safetensors
**/*.rst
